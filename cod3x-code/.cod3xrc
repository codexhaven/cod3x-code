{
  "name": "cod3x-project",
  "version": "1.0.0",
  "description": "Cod3x AI Coding Assistant Configuration",
  
  "permissions": {
    "askBeforeBash": true,
    "askBeforeWrite": true,
    "askBeforeDelete": true,
    "askBeforeNetwork": false,
    "blockedCommands": [
      "rm -rf /",
      "sudo",
      "mkfs",
      "dd if=",
      ":(){",
      "del /f",
      "format"
    ],
    "autoApprove": [
      "^ls ",
      "^pwd$",
      "^echo ",
      "^cat "
    ]
  },
  
  "context": {
    "maxFiles": 100,
    "includePatterns": [
      "**/*.{js,ts,jsx,tsx,py,go,rs,java,kt,md,json,yaml,yml}",
      "**/*.{css,scss,html,xml,svg}",
      "**/package.json",
      "**/requirements.txt",
      "**/go.mod",
      "**/Cargo.toml"
    ],
    "excludePatterns": [
      "node_modules/**",
      ".git/**",
      "dist/**",
      "build/**",
      "__pycache__/**",
      "target/**",
      "*.log",
      ".env",
      "coverage/**"
    ],
    "gitEnabled": true,
    "followSymlinks": false
  },
  
  "ai": {
    "provider": "openrouter",
    "model": "claude-3.5-sonnet",
    "temperature": 0.7,
    "maxTokens": 4096,
    "topP": 1.0,
    "frequencyPenalty": 0,
    "presencePenalty": 0,
    "systemPrompt": "You are Cod3x, a thoughtful AI coding assistant...",
    "fallbackProvider": "groq"
  },
  
  "mcp": {
    "enabled": false,
    "port": 8765,
    "host": "localhost",
    "autoStart": false,
    "tools": ["read_file", "write_file", "execute_command"],
    "authToken": null
  },
  
  "hooks": {
    "preTool": true,
    "postTool": true,
    "onError": true,
    "customHooksPath": "./.cod3x/hooks"
  },
  
  "ide": {
    "enabled": true,
    "vscode": true,
    "autoOpenFiles": true,
    "inlineSuggestions": true,
    "syncSettings": true
  },
  
  "ui": {
    "theme": "default",
    "showLineNumbers": true,
    "syntaxHighlight": true,
    "compactMode": false,
    "colors": {
      "user": "cyan",
      "assistant": "magenta",
      "system": "gray",
      "error": "red",
      "success": "green",
      "warning": "yellow"
    }
  },
  
  "logging": {
    "level": "info",
    "file": "./logs/cod3x.log",
    "maxSize": "10MB",
    "maxFiles": 10,
    "console": true,
    "jsonFormat": false
  },
  
  "features": {
    "autoCompact": true,
    "suggestImprovements": true,
    "trackUsage": false,
    "telemetry": false,
    "autoSave": true,
    "autoComplete": true
  },
  
  "limits": {
    "maxFileSize": 10485760,
    "maxOutputSize": 10000,
    "maxSearchResults": 100,
    "maxConversationAge": 86400000,
    "maxTokenUsage": 1000000
  }
}
