{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@core/*": ["./src/core/*"],
      "@tools/*": ["./src/tools/*"],
      "@commands/*": ["./src/commands/*"],
      "@agents/*": ["./src/agents/*"],
      "@mcp/*": ["./src/mcp/*"],
      "@ui/*": ["./src/ui/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@memory/*": ["./src/memory/*"],
      "@utils/*": ["./src/utils/*"],
      "@config/*": ["./src/config/*"],
      "@codex-types/*": ["./src/types/*"],
      "@context/*": ["./src/context/*"],
      "@llm/*": ["./src/llm/*"],
      "@platform/*": ["./src/platform/*"],
      "@swarm/*": ["./src/swarm/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
