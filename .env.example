# ═══════════════════════════════════════════════════════════
# Cod3x Code v4.0 - Environment Configuration
# Developed by CodexHaven - https://github.com/codexhaven
# ═══════════════════════════════════════════════════════════

# ─── OpenCode Free Proxy (Default - Recommended) ───
# The opencode-free-proxy provides free access to Claude, GPT, Gemini
# Install from: https://github.com/sionex-code/opencode-proxy-api
OPENCODE_PROXY_URL=http://localhost:8000/v1
OPENCODE_PROXY_KEY=not-needed-for-local

# ─── Alternative: Direct API Keys ───
# Anthropic API (for Claude models)
ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenRouter (supports 200+ models)
OPENROUTER_API_KEY=your-openrouter-api-key

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# Google AI (Gemini)
GOOGLE_API_KEY=your-google-api-key

# ─── Cod3x Configuration ───
COD3X_PROVIDER=opencode-proxy
COD3X_MODEL=claude-sonnet-4
COD3X_TEMPERATURE=0.7
COD3X_MAX_TOKENS=8192

# ─── Platform Override (auto-detected if not set) ───
# PLATFORM=termux|linux|win32|darwin|android

# ─── Permission Overrides ───
# COD3X_ASK_BEFORE_BASH=true
# COD3X_ASK_BEFORE_WRITE=true
# COD3X_ASK_BEFORE_DELETE=true
# COD3X_ASK_BEFORE_NETWORK=true

# ─── Swarm Agent Configuration ───
# COD3X_SWARM_ENABLED=true
# COD3X_SWARM_MAX_CONCURRENT=5
# COD3X_SWARM_STRATEGY=parallel

# ─── Advanced Features ───
# COD3X_BROWSER_ENABLED=true
# COD3X_DEBUG_TRAIL=true
# COD3X_MCP_ENABLED=true
# COD3X_TELEMETRY=false
