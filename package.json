{
  "name": "cod3x-code",
  "version": "4.0.0",
  "description": "Cod3x Code v4.0 by CodexHaven - Production-ready AI coding assistant with 80+ tools, swarm agents, MCP support, and multi-platform compatibility",
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "cod3x": "./dist/main.js",
    "c3": "./dist/main.js",
    "cod3x-code": "./dist/main.js"
  },
  "imports": {
    "#core/*": "./dist/core/*",
    "#tools/*": "./dist/tools/*",
    "#commands/*": "./dist/commands/*",
    "#agents/*": "./dist/agents/*",
    "#mcp/*": "./dist/mcp/*",
    "#ui/*": "./dist/ui/*",
    "#hooks/*": "./dist/hooks/*",
    "#memory/*": "./dist/memory/*",
    "#utils/*": "./dist/utils/*",
    "#config/*": "./dist/config/*",
    "#codex-types/*": "./dist/types/*",
    "#context/*": "./dist/context/*",
    "#llm/*": "./dist/llm/*",
    "#platform/*": "./dist/platform/*",
    "#swarm/*": "./dist/swarm/*"
  },
  "scripts": {
    "build": "tsc && node scripts/fix-dist-paths.js && chmod +x dist/main.js",
    "dev": "tsx src/main.tsx",
    "start": "bash start.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ --ext .ts,.tsx",
    "lint:fix": "eslint src/ --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "postinstall": "node scripts/postinstall.js"
  },
  "keywords": [
    "ai",
    "coding-assistant",
    "cli",
    "claude-code",
    "agent",
    "mcp",
    "swarm",
    "productivity",
    "developer-tools",
    "code-generation",
    "code-review",
    "debugger",
    "codexhaven",
    "cod3x",
    "termux",
    "multi-platform"
  ],
  "author": "CodexHaven <dev@codexhaven.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/codexhaven/cod3x-code.git"
  },
  "bugs": {
    "url": "https://github.com/codexhaven/cod3x-code/issues"
  },
  "homepage": "https://github.com/codexhaven/cod3x-code#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@google/generative-ai": "^0.21.0",
    "boxen": "^8.0.1",
    "chalk": "^5.3.0",
    "cheerio": "^1.0.0",
    "clipboardy": "^4.0.0",
    "commander": "^12.1.0",
    "diff": "^5.2.0",
    "dotenv": "^16.4.5",
    "figures": "^6.1.0",
    "glob": "^10.5.0",
    "highlight.js": "^11.10.0",
    "ignore": "^6.0.2",
    "ink": "^4.4.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^5.0.0",
    "marked": "^14.1.2",
    "marked-terminal": "^7.1.0",
    "node-fetch": "^3.3.2",
    "openai": "^4.73.0",
    "ora": "^8.1.0",
    "puppeteer-core": "^25.1.0",
    "react": "^18.3.1",
    "semver": "^7.6.3",
    "simple-git": "^3.27.0",
    "tar": "^7.4.3",
    "toml": "^3.0.0",
    "ws": "^8.18.0",
    "yaml": "^2.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/diff": "^5.2.3",
    "@types/node": "^22.19.19",
    "@types/react": "^18.3.29",
    "@types/semver": "^7.7.1",
    "@types/tar": "^6.1.13",
    "@types/turndown": "^5.0.5",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^2.1.5"
  }
}
