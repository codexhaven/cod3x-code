{
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install --legacy-peer-deps && npm run build",
    "nixpacks": {
      "nodeVersion": "22"
    }
  },
  "deploy": {
    "startCommand": "node server.mjs",
    "healthcheckPath": "/api/status",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
